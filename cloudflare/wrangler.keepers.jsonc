  "vars": {
    "VELO_KEEPERS_ENABLED": "false",
    "VELO_KEEPERS_DRY_RUN": "true",
    "VELO_KEEPER_BASE_URL": "https://btgfoekgvyvdflzjfehz.supabase.co/functions/v1/velo-keepers"
  },
  "triggers": {
    // After backend validation, secret transfer and disabling Vercel's jobs,
    // replace [] with ["* * * * *"] and explicitly enable the scheduler.
    "crons": []
  }
}
